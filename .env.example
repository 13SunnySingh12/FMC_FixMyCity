# Copy to .env and fill in. Never commit .env.
# Keep one KEY=value per line with no inline comments (the backend reads this file as .properties).

# Neon PostgreSQL — Neon console > Connect > connection string (direct, not pooled)
DATABASE_URL=<SET_LOCALLY>

# Signing key for login tokens (48+ random bytes, URL-safe base64)
JWT_SECRET=<SET_LOCALLY>

# Shared secret the backend sends to the AI service
AI_SERVICE_API_KEY=<SET_LOCALLY>

# Bootstrap admin, created on first start when no admin exists
ADMIN_EMAIL=<SET_LOCALLY>
ADMIN_PASSWORD=<SET_LOCALLY>

# Backblaze B2 private bucket (S3-compatible endpoint, e.g. s3.<region>.backblazeb2.com)
B2_ENDPOINT=<SET_LOCALLY>
B2_BUCKET=<SET_LOCALLY>
B2_KEY_ID=<SET_LOCALLY>
B2_APPLICATION_KEY=<SET_LOCALLY>

# AI providers
GEMINI_API_KEY=<SET_LOCALLY>
GROQ_API_KEY=<SET_LOCALLY>

# Optional overrides (defaults shown). Uncomment only to change them.
# Where the backend reaches the AI service; Docker Compose sets http://ai:8000 itself.
# AI_SERVICE_URL=http://localhost:8000
# Host port for the Docker Compose frontend.
# FRONTEND_PORT=8081
# Models; providers retire model names, so these can change without a code change.
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
